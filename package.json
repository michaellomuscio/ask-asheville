{
  "name": "ask-asheville",
  "version": "0.1.0",
  "description": "Ask Asheville: a student-facing 3D model of Asheville and Buncombe County for asking questions about the city and answering them with evidence.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:questions": "node tools/drive.mjs http://localhost:5180/ /tmp/ask-asheville-check tools/steps/questions.mjs --size 1366x768",
    "headless": "node scripts/headless.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
